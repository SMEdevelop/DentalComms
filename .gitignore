# Build output. DentalComms.exe is a build artifact, not source - ship it as a
# GitHub Release asset rather than committing a 1.2 MB binary that changes on
# every build and would bloat the history of every clone.
/build/
*.exe
*.o
*.obj

# Packaged release zips, kept here for handing to the office. The copy that
# matters is the one attached to the GitHub release for that tag.
*.zip

# Written at runtime, and holds the office's own live settings: station names,
# quick-message buttons, allowed host names. Dental Comms recreates it with the
# defaults on first start, so a fresh clone needs nothing here.
/data/config.json

# Optional local port override (see the README).
/port.txt

# Superseded builds kept locally for rollback and comparison. Binaries, and
# not part of the current source tree - see archive/*/README.txt.
/archive/
