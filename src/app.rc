#include <windows.h>

// The icon Explorer, the Start menu shortcut and the installer show for
// DentalComms.exe. The window and tray icon are still drawn at runtime by
// makeIcon() in gui.cpp; app.ico is made from public\icon-512.png, the same
// picture staff see on the web page, so all of them match.
1 ICON "app.ico"

// Common controls 6 and per-monitor DPI awareness - see app.manifest.
1 24 "app.manifest"

// Version resource: this is what Explorer's Details tab and "right-click ->
// Properties" read. The G++ build shipped without one, so DentalComms.exe
// showed no version at all; the MSVC build stamps it properly.
//
// Keep these numbers in step with src\version.h. package.bat parses the
// FileVersion string below to name the zip, so it is the authoritative copy.
VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,9,6,0
PRODUCTVERSION 0,9,6,0
FILEFLAGSMASK 0x3fL
// VS_FF_PRERELEASE: this is beta 0.8, and Windows will say so.
FILEFLAGS VS_FF_PRERELEASE
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",     "SMEdevelop"
            VALUE "FileDescription", "Dental Comms - intraoffice messaging server"
            VALUE "FileVersion",     "0.9.6.0"
            VALUE "InternalName",    "DentalComms"
            VALUE "LegalCopyright",  "Copyright (c) 2026 SMEdevelop. MIT License."
            VALUE "OriginalFilename","DentalComms.exe"
            VALUE "ProductName",     "Dental Comms"
            VALUE "ProductVersion",  "0.9.6.0 beta"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
